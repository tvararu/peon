+bool Map::FindLiquid(const math::Vertex& position, float& surface) const
+{
+    constexpr float reach = 0.5f;
+    constexpr float extents[] = {reach, 4.f, reach};
+
+    float recastPosition[3];
+    math::Convert::VertexToRecast(position, recastPosition);
+
+    dtPolyRef polyRef = 0;
+    float nearest[3];
+    if (m_navQuery.findNearestPoly(recastPosition, extents, &m_queryFilter,
+                                   &polyRef, nearest) != DT_SUCCESS ||
+        !polyRef)
+        return false;
+
+    if (std::abs(nearest[0] - recastPosition[0]) > reach ||
+        std::abs(nearest[2] - recastPosition[2]) > reach)
+        return false;
+
+    const dtMeshTile* tile = nullptr;
+    const dtPoly* poly = nullptr;
+    if (m_navMesh.getTileAndPolyByRef(polyRef, &tile, &poly) != DT_SUCCESS)
+        return false;
+
+    if (!(poly->flags & PolyFlags::Liquid))
+        return false;
+
+    surface = nearest[1];
+    return true;
+}
