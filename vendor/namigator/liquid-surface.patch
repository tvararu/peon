+PathfindResultType pathfind_find_liquid(pathfind::Map* const map, float x,
+                                        float y, float z,
+                                        unsigned char* const liquid,
+                                        float* const surface_z)
+{
+    try
+    {
+        float surface;
+        if (map->FindLiquid({x, y, z}, surface))
+        {
+            *liquid = 1;
+            *surface_z = surface;
+        }
+        else
+            *liquid = 0;
+
+        return static_cast<PathfindResultType>(Result::SUCCESS);
+    }
+    catch (utility::exception& e)
+    {
+        return static_cast<PathfindResultType>(e.ResultCode());
+    }
+    catch (...)
+    {
+        return static_cast<PathfindResultType>(Result::UNKNOWN_EXCEPTION);
+    }
+}
